#!/usr/bin/env ruby
# frozen_string_literal: true

# Prints a pull request body listing the upstream Swagger UI releases after
# FROM_VERSION up to and including TO_VERSION. Requires an authenticated `gh`.

require 'json'
require 'open3'
require 'rubygems'

REPO = 'swagger-api/swagger-ui'
# GitHub rejects pull request bodies over 65536 characters.
MAX_BODY = 60_000

from_version = Gem::Version.new(ENV.fetch('FROM_VERSION').delete_prefix('v'))
to_version = Gem::Version.new(ENV.fetch('TO_VERSION').delete_prefix('v'))

output, status = Open3.capture2('gh', 'api', '--paginate', "repos/#{REPO}/releases?per_page=100", '--jq', '.[]')
abort "Could not list #{REPO} releases." unless status.success?

releases = output.each_line.map { |line| JSON.parse(line) }.select do |release|
  next false if release['draft'] || release['prerelease']

  version = Gem::Version.new(release['tag_name'].delete_prefix('v'))
  version > from_version && version <= to_version
rescue ArgumentError
  false
end
releases.sort_by! { |release| Gem::Version.new(release['tag_name'].delete_prefix('v')) }.reverse!

# Upstream heading levels vary between releases; nest the release title and its sections under "Swagger UI changes".
def nest_headings(body)
  title = true
  body.gsub(/^#+ /) do
    heading = title ? '### ' : '#### '
    title = false
    heading
  end
end

def format_notes(release)
  body = release['body'].to_s.gsub("\r\n", "\n").gsub(/\n{3,}/, "\n\n").strip
  return "### [#{release['tag_name']}](#{release['html_url']})\n\nNo release notes." if body.empty?

  # Avoid pinging upstream contributors.
  nest_headings(body).gsub(%r{(?<![\w`\[/])@([\w-]+)}, '`@\1`')
end

compare_url = "https://github.com/#{REPO}/compare/v#{from_version}...v#{to_version}"
body = <<~MARKDOWN
  Updates bundled Swagger UI assets from `v#{from_version}` to `v#{to_version}` ([compare](#{compare_url})).

  Generated by the scheduled Swagger UI update workflow.

  ## Swagger UI changes
MARKDOWN

if releases.empty?
  body << "\nNo release notes found. See the [compare view](#{compare_url}).\n"
else
  releases.each do |release|
    notes = "\n#{format_notes(release)}\n"
    if body.length + notes.length > MAX_BODY
      body << "\nRelease notes truncated. See the [compare view](#{compare_url}) for the rest.\n"
      break
    end
    body << notes
  end
end

puts body
