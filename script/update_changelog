#!/usr/bin/env ruby
# frozen_string_literal: true

path = ENV.fetch('CHANGELOG_PATH', 'CHANGELOG.md')
number = ENV.fetch('PR_NUMBER')
url = ENV.fetch('PR_URL')
# danger-changelog only accepts [\w-]+ author names, so `github-actions[bot]` becomes `github-actions`.
author = ENV.fetch('PR_AUTHOR').delete_suffix('[bot]')
author_url = ENV.fetch('PR_AUTHOR_URL')
title = ENV.fetch('PR_TITLE').gsub(/\s+/, ' ').strip.sub(/\.+\z/, '')
title = title.gsub(/([\[\]])/, '\\\\\1')

entry = "* [##{number}](#{url}): #{title} - [@#{author}](#{author_url})."
changelog = File.read(path)

existing = changelog.lines.find { |line| line.start_with?("* [##{number}](") }
if existing
  # Leave hand-edited entries alone; only repair ones Danger would reject.
  exit if existing.match?(%r{ - \[@[\w-]+\]\(https://github\.com/\S*[\w-]\)\.$})
  File.write(path, changelog.sub(existing, "#{entry}\n"))
  exit
end

next_release = /^### Next Release\s*$/
placeholder = /^\* Your contribution here\.\s*$/
heading = changelog.match(next_release)
abort 'CHANGELOG.md has no "### Next Release" section.' unless heading

section_start = heading.end(0)
next_heading = changelog.match(/^### /, section_start)
section_end = next_heading ? next_heading.begin(0) : changelog.length
section = changelog[section_start...section_end]
insertion = section.match(placeholder)
abort 'The "Next Release" section has no contribution placeholder.' unless insertion

offset = section_start + insertion.begin(0)
changelog.insert(offset, "#{entry}\n")
File.write(path, changelog)
